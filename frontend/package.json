{
  "name": "great-gear-generator-ui",
  "private": true,
  "version": "0.4.1",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "build": "tsc -b && vite build",
    "test": "vitest run src",
    "test:e2e": "playwright test",
    "deploy:surge": "npm run build && surge ./dist greatgeargenerator-bucala.surge.sh",
    "deploy:request": "gh workflow run deploy.yml --repo bucala/GreatGearGenerator --ref main"
  },
  "dependencies": {
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "replicad": "^1.2.0",
    "replicad-opencascadejs": "^1.1.0",
    "tailwindcss": "^4.0.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^4.4.0",
    "typescript": "~5.9.3",
    "vite": "^6.3.0",
    "vitest": "^5.1.0"
  }
}
